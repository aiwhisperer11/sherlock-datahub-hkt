# Comma-separated origins allowed to call the local API.
SHERLOCK_CORS_ORIGINS=http://localhost:3000
# Metadata mode: sandbox (default), mcp, graphql, or auto.
SHERLOCK_METADATA_MODE=sandbox
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
# Default "uvx" resolves via PATH: `uv` is a project dependency, so pip/uv install
# already places the uvx console script in the active venv. Override only if your
# environment needs an absolute path.
SHERLOCK_DATAHUB_MCP_COMMAND=uvx
SHERLOCK_DATAHUB_MCP_PACKAGE=mcp-server-datahub@latest
# 30s default: the document-preview flow runs get_entities + get_lineage in one
# MCP session, which can approach 15-20s under a loaded local Quickstart.
SHERLOCK_DATAHUB_TIMEOUT_SECONDS=30

# Base URL of the canonical Sherlock-Core investigation engine (the real
# https://github.com/aiwhisperer11/sherlock-engine service, e.g. deployed at
# https://sherlock-engine.vercel.app). Do NOT include /api/investigate; the
# backend appends it. Leave unset to always use the local fallback reasoning
# (derive_reasoning_consequence) instead of the canonical engine.
SHERLOCK_CORE_URL=
# 90s default: a real baseline call with DataHub evidence measured 49-66s
# against the deployed engine — the LLM does more reasoning work per
# evidence item than a trivial smoke-test call.
SHERLOCK_CORE_TIMEOUT_SECONDS=90
