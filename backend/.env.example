# Comma-separated origins allowed to call the local API.
SHERLOCK_CORS_ORIGINS=http://localhost:3000
# Metadata mode: sandbox (default), mcp, graphql, or auto.
SHERLOCK_METADATA_MODE=sandbox
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
SHERLOCK_DATAHUB_MCP_COMMAND=/home/work/.local/bin/uvx
SHERLOCK_DATAHUB_MCP_PACKAGE=mcp-server-datahub@latest
SHERLOCK_DATAHUB_TIMEOUT_SECONDS=15
